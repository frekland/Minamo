{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "minamo-v2-staging",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-28",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "services": [{ "binding": "MCP_ACCEPTANCE_CLIENT", "service": "minamo-mcp-acceptance-client" }],
  "vars": { "MINAMO_RUNTIME_MODE": "synthetic-only" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "minamo-v2-cf-staging",
      "database_id": "839bc4bd-f36d-4fd4-a856-4c26cb70f940",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 }
  }
}
