# Independent Cloudflare staging Auth0 configuration placeholders.
# Replace these only with a dedicated synthetic-only Auth0 test application.
# Register the callback URL under Allowed Callback URLs in that application.
# Register the logout URL under Allowed Logout URLs.
AUTH0_DOMAIN=your-tenant.eu.auth0.com
AUTH0_CLIENT_ID=replace-with-public-client-id
AUTH0_MCP_AUDIENCE=https://minamo-v2-staging.jlscott-uk.workers.dev/mcp
AUTH0_CALLBACK_URL=https://minamo-v2-staging.jlscott-uk.workers.dev/auth/callback
AUTH0_LOGOUT_RETURN_URL=https://minamo-v2-staging.jlscott-uk.workers.dev/account
# Keep AUTH0_CLIENT_SECRET out of this file and Git.
# Configure it in Cloudflare's secret management before any staging deployment.
