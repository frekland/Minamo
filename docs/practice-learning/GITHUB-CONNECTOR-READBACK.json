  "submissionRead": {
    "content": "\"\"\"SYNTHETIC SUBMISSION — finite EOF exercise, not a persistent protocol.\"\"\"\ndef collect_message(recv_chunk, max_bytes=65536):\n    chunks = []\n    total = 0\n    while True:\n        chunk = recv_chunk(4)\n        if not chunk:\n            return b\"\".join(chunks)\n        total += len(chunk)\n        if total > max_bytes:\n            raise ValueError(\"maximum size exceeded\")\n        chunks.append(chunk)\n",
