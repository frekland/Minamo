+.pi-language-detail{white-space:pre-wrap;overflow-wrap:anywhere;line-height:1.65;background:var(--mn-surface-secondary,var(--background));border-radius:10px;padding:.7rem 1rem;margin:.6rem 0}
+.pi-language-detail strong{display:block;font-size:.75rem;letter-spacing:.05em;opacity:.8}
+.pi-language .pi-toolbar button,.pi-language>button{min-height:40px;border:1px solid var(--mn-border-control);background:var(--mn-surface-secondary,var(--background));border-radius:9px;padding:.4rem .8rem;color:inherit}
+.pi-language-slots{display:flex;flex-wrap:wrap;gap:1rem}.pi-language-slots label{display:grid;gap:.4rem;min-width:min(100%,155px);flex:1}.pi-language-slots select{min-height:40px;max-width:100%;border-radius:8px}
+.pi-dialogue{list-style:none;padding:0;margin:0;display:grid;gap:.8rem}.pi-dialogue li{border-inline-start:3px solid var(--mn-border-control);padding:.5rem .8rem;background:var(--mn-surface-secondary,var(--background));border-radius:0 9px 9px 0;min-width:0}
 .pi-drawing-fullscreen>.pi-drawing-editor{flex:1;min-height:0;height:auto!important;max-height:none!important}
 .pc-expanded .pi-drawing-fullscreen>.pi-drawing-editor{height:auto!important}
 .pi-drawing-fullscreen .tl-container{height:100%!important}
